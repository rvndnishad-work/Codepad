{
	"if": { "prefix": "if", "body": ["if ${1:condition}:", "\t${2:pass}"], "description": "if statement" },
	"if/else": { "prefix": ["ifelse", "ife"], "body": ["if ${1:condition}:", "\t${2:pass}", "else:", "\t${3:pass}"], "description": "if/else statement" },
	"elif": { "prefix": "elif", "body": ["elif ${1:condition}:", "\t${2:pass}"], "description": "elif clause" },
	"else": { "prefix": "else", "body": ["else:", "\t${1:pass}"], "description": "else clause" },
	"for": { "prefix": "for", "body": ["for ${1:item} in ${2:iterable}:", "\t${3:pass}"], "description": "for loop" },
	"for range": { "prefix": ["forr", "forrange"], "body": ["for ${1:i} in range(${2:n}):", "\t${3:pass}"], "description": "for loop over range()" },
	"for enumerate": { "prefix": ["fore", "forenum"], "body": ["for ${1:i}, ${2:item} in enumerate(${3:iterable}):", "\t${4:pass}"], "description": "for loop with enumerate()" },
	"while": { "prefix": "while", "body": ["while ${1:condition}:", "\t${2:pass}"], "description": "while loop" },
	"def": { "prefix": "def", "body": ["def ${1:name}(${2:args}):", "\t${3:pass}"], "description": "function definition" },
	"async def": { "prefix": ["adef", "async def"], "body": ["async def ${1:name}(${2:args}):", "\t${3:pass}"], "description": "async function definition" },
	"method": { "prefix": ["defs", "method"], "body": ["def ${1:name}(self${2:, args}):", "\t${3:pass}"], "description": "method definition" },
	"class": { "prefix": "class", "body": ["class ${1:ClassName}:", "\tdef __init__(self${2:, args}):", "\t\t${3:pass}"], "description": "class definition" },
	"dataclass": { "prefix": "dataclass", "body": ["@dataclass", "class ${1:ClassName}:", "\t${2:field}: ${3:int}"], "description": "dataclass" },
	"try/except": { "prefix": ["try", "trye"], "body": ["try:", "\t${1:pass}", "except ${2:Exception} as ${3:e}:", "\t${4:raise}"], "description": "try/except block" },
	"try/except/finally": { "prefix": ["tryf", "trycf"], "body": ["try:", "\t${1:pass}", "except ${2:Exception} as ${3:e}:", "\t${4:raise}", "finally:", "\t${5:pass}"], "description": "try/except/finally block" },
	"with": { "prefix": "with", "body": ["with ${1:expression} as ${2:target}:", "\t${3:pass}"], "description": "with statement" },
	"with open": { "prefix": ["wopen", "open"], "body": ["with open(${1:path}, \"${2:r}\") as ${3:f}:", "\t${4:data = f.read()}"], "description": "open a file with a context manager" },
	"lambda": { "prefix": "lambda", "body": "lambda ${1:x}: ${2:x}", "description": "lambda expression" },
	"main guard": { "prefix": ["ifmain", "main", "__main__"], "body": ["if __name__ == \"__main__\":", "\t${1:main()}"], "description": "if __name__ == \"__main__\"" },
	"print": { "prefix": ["print", "pr"], "body": "print(${1})", "description": "print()" },
	"f-string print": { "prefix": "printf", "body": "print(f\"${1:{value}}\")", "description": "print an f-string" },
	"list comprehension": { "prefix": ["lc", "listcomp"], "body": "[${1:x} for ${2:x} in ${3:iterable}]", "description": "list comprehension" },
	"dict comprehension": { "prefix": ["dc", "dictcomp"], "body": "{${1:k}: ${2:v} for ${1:k}, ${2:v} in ${3:items}}", "description": "dict comprehension" },
	"import": { "prefix": "import", "body": "import ${1:module}", "description": "import a module" },
	"from import": { "prefix": ["from", "fromim"], "body": "from ${1:module} import ${2:name}", "description": "from ... import ..." }
}
