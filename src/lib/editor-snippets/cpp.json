{
	"main": { "prefix": "main", "body": ["int main(int argc, const char** argv) {", "\t$0", "\treturn 0;", "}"], "description": "main function" },
	"include": { "prefix": ["#include", "inc"], "body": "#include <${1:iostream}>", "description": "#include <header>" },
	"include local": { "prefix": ["#include\"", "incl"], "body": "#include \"${1:header.h}\"", "description": "#include \"header\"" },
	"cout": { "prefix": "cout", "body": "std::cout << ${1:value} << std::endl;", "description": "std::cout" },
	"cin": { "prefix": "cin", "body": "std::cin >> ${1:value};", "description": "std::cin" },
	"printf": { "prefix": "printf", "body": "printf(\"${1:%d}\\\\n\", ${2:value});", "description": "printf" },
	"for": { "prefix": "for", "body": ["for (${1:size_t} ${2:i} = 0; ${2:i} < ${3:count}; ${2:i}++) {", "\t$0", "}"], "description": "for loop" },
	"for reverse": { "prefix": "forr", "body": ["for (int ${1:i} = ${2:length} - 1; ${1:i} >= 0; ${1:i}--) {", "\t$0", "}"], "description": "reverse for loop" },
	"range for": { "prefix": ["foreach", "fore"], "body": ["for (auto& ${1:item} : ${2:container}) {", "\t$0", "}"], "description": "range-based for loop" },
	"while": { "prefix": "while", "body": ["while (${1:condition}) {", "\t$0", "}"], "description": "while loop" },
	"do": { "prefix": "do", "body": ["do {", "\t$0", "} while (${1:condition});"], "description": "do-while loop" },
	"if": { "prefix": "if", "body": ["if (${1:condition}) {", "\t$0", "}"], "description": "if statement" },
	"else": { "prefix": "else", "body": ["else {", "\t$0", "}"], "description": "else clause" },
	"else if": { "prefix": "else if", "body": ["else if (${1:condition}) {", "\t$0", "}"], "description": "else if clause" },
	"switch": { "prefix": "switch", "body": ["switch (${1:value}) {", "\tcase ${2:0}:", "\t\t$0", "\t\tbreak;", "\tdefault:", "\t\tbreak;", "}"], "description": "switch statement" },
	"case": { "prefix": "case", "body": ["case ${1:value}:", "\t$0", "\tbreak;"], "description": "case label" },
	"try": { "prefix": "try", "body": ["try {", "\t$0", "} catch (const std::exception& ${1:e}) {", "\tstd::cerr << ${1:e}.what() << std::endl;", "}"], "description": "try/catch block" },
	"class": { "prefix": "class", "body": ["class ${1:Name} {", "public:", "\t${1:Name}();", "\t~${1:Name}();", "", "private:", "\t$0", "};"], "description": "class definition" },
	"struct": { "prefix": "struct", "body": ["struct ${1:Name} {", "\t$0", "};"], "description": "struct definition" },
	"enum": { "prefix": "enum", "body": ["enum ${1:Name} {", "\t$0", "};"], "description": "enum" },
	"enum class": { "prefix": "enumclass", "body": ["enum class ${1:Name} {", "\t$0", "};"], "description": "scoped enum" },
	"namespace": { "prefix": "namespace", "body": ["namespace ${1:name} {", "\t$0", "}"], "description": "namespace" },
	"#ifndef guard": { "prefix": ["#ifndef", "guard"], "body": ["#ifndef ${1:HEADER_H}", "#define ${1:HEADER_H}", "", "$0", "", "#endif // ${1:HEADER_H}"], "description": "include guard" },
	"vector": { "prefix": "vector", "body": "std::vector<${1:int}> ${2:v};", "description": "std::vector" },
	"lambda": { "prefix": "lambda", "body": "[${1:&}](${2:auto x}) { $0 }", "description": "lambda expression" }
}
