{
	"main": { "prefix": "main", "body": ["fn main() {", "\t$0", "}"], "description": "main function" },
	"fn": { "prefix": "fn", "body": ["fn ${1:name}(${2}) {", "\t$0", "}"], "description": "function" },
	"pub fn": { "prefix": "pfn", "body": ["pub fn ${1:name}(${2}) {", "\t$0", "}"], "description": "public function" },
	"test fn": { "prefix": "tfn", "body": ["#[test]", "fn ${1:feature}() {", "\t$0", "}"], "description": "#[test] function" },
	"test module": { "prefix": "tmod", "body": ["#[cfg(test)]", "mod tests {", "\tuse super::*;", "", "\t#[test]", "\tfn ${1:test_name}() {", "\t\t$0", "\t}", "}"], "description": "test module" },
	"println": { "prefix": ["println", "pl"], "body": "println!(\"${1:{\\}}\", ${2:value});", "description": "println!" },
	"eprintln": { "prefix": "eprintln", "body": "eprintln!(\"${1:{\\}}\", ${2:value});", "description": "eprintln!" },
	"debug print": { "prefix": "pd", "body": "eprintln!(\"${1:value} = {:?}\", ${1:value});", "description": "eprintln! a value with {:?}" },
	"pretty debug print": { "prefix": "ppd", "body": "eprintln!(\"${1:value} = {:#?}\", ${1:value});", "description": "eprintln! a value with {:#?}" },
	"let": { "prefix": "let", "body": "let ${1:name} = ${2:value};", "description": "let binding" },
	"let mut": { "prefix": "letm", "body": "let mut ${1:name} = ${2:value};", "description": "mutable let binding" },
	"if": { "prefix": "if", "body": ["if ${1:condition} {", "\t$0", "}"], "description": "if expression" },
	"if let": { "prefix": "iflet", "body": ["if let ${1:Some(x)} = ${2:option} {", "\t$0", "}"], "description": "if let" },
	"match": { "prefix": "match", "body": ["match ${1:value} {", "\t${2:pattern} => ${3:todo!()},", "\t_ => ${4:todo!()},", "}"], "description": "match expression" },
	"for": { "prefix": "for", "body": ["for ${1:item} in ${2:iter} {", "\t$0", "}"], "description": "for loop" },
	"while": { "prefix": "while", "body": ["while ${1:condition} {", "\t$0", "}"], "description": "while loop" },
	"loop": { "prefix": "loop", "body": ["loop {", "\t$0", "}"], "description": "loop" },
	"struct": { "prefix": "struct", "body": ["#[derive(Debug)]", "struct ${1:Name} {", "\t${2:field}: ${3:Type},", "}"], "description": "struct" },
	"enum": { "prefix": "enum", "body": ["#[derive(Debug)]", "enum ${1:Name} {", "\t${2:Variant},", "}"], "description": "enum" },
	"impl": { "prefix": "impl", "body": ["impl ${1:Type} {", "\t$0", "}"], "description": "impl block" },
	"impl trait": { "prefix": "implt", "body": ["impl ${1:Trait} for ${2:Type} {", "\t$0", "}"], "description": "impl Trait for Type" },
	"trait": { "prefix": "trait", "body": ["trait ${1:Name} {", "\t$0", "}"], "description": "trait" },
	"derive": { "prefix": "derive", "body": "#[derive(${1:Debug, Clone})]", "description": "#[derive]" },
	"vec": { "prefix": "vec", "body": "vec![${1}]", "description": "vec!" },
	"macro_rules": { "prefix": "macro_rules", "body": ["macro_rules! ${1:name} {", "\t(${2}) => {", "\t\t$0", "\t};", "}"], "description": "macro_rules!" }
}
