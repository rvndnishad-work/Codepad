{
  "name": "codepad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:signal": "npx y-webrtc-signaling --port 4444",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:signal\"",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "node scripts/lint.cjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:challenges": "npx tsx prisma/seed-all-challenges.ts",
    "seed:prompt": "npx tsx prisma/seed-prompt-scenarios.ts && npx tsx prisma/seed-prompt-exemplars.ts",
    "seed:review": "npx tsx prisma/seed-review-challenges.ts",
    "seed:roles": "npx tsx prisma/seed-roles.ts",
    "seed:creator": "npx tsx prisma/seed-creator-space.ts",
    "seed:iq": "npx tsx prisma/seed-interview-questions.ts",
    "seed:js-coding": "npx tsx scripts/generate-js-coding-data.ts && npx tsx prisma/seed-js-coding.ts",
    "generate:questions": "npx tsx prisma/generate-question-bank.ts",
    "seed:question-bank": "npx tsx prisma/seed-question-bank.ts",
    "seed:curated": "npx tsx prisma/seed-curated-questions.ts",
    "augment:js": "npx tsx prisma/augment-js-examples.ts",
    "augment:react": "npx tsx prisma/augment-react-examples.ts",
    "augment:sd": "npx tsx prisma/augment-system-design.ts",
    "augment:ng": "npx tsx prisma/augment-angular.ts",
    "augment:node": "npx tsx prisma/augment-node.ts",
    "augment:next": "npx tsx prisma/augment-nextjs.ts",
    "augment:ai": "npx tsx prisma/augment-ai.ts",
    "augment:py": "npx tsx prisma/augment-python.ts",
    "augment:dsa": "npx tsx prisma/augment-dsa.ts",
    "augment:mc": "npx tsx prisma/augment-machine-coding.ts",
    "augment:sql": "npx tsx prisma/augment-sql.ts",
    "generate:mc": "npx tsx prisma/generate-mc-answers.ts",
    "seed:mc-generated": "npx tsx prisma/seed-mc-generated.ts",
    "postinstall": "prisma generate",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:e2e:ui": "node scripts/run-e2e-tests.js --ui",
    "clean": "node -e \"const fs=require('fs'); ['.next','.next-test','tsconfig.tsbuildinfo'].forEach(p => fs.rmSync(p, {recursive:true, force:true}));\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
