    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/html": "3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@typescript/ata": "^0.9.8",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "lottie-react": "^3.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.41.0",
    "monaco-themes": "^0.4.8",
    "nanoid": "^6.0.1",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "otplib": "^12.0.1",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "randomcolor": "^0.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
