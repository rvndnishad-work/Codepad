-next-line react-hooks/purity\n> 61 |   const windowStart = new Date(Date.now() - WINDOW_DAYS * DAY_MS);\n     |                                ^^^^^^^^^^ Cannot call impure function\n  62 |\n  63 |   const [\n  64 |     account,",["393"],["394"],"@typescript-eslint/no-unused-vars","'LayoutGrid' is defined but never used.","Identifier","unusedVar",["395"],"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\arvin\\OneDrive\\Desktop\\claude\\code\\codepad\\src\\app\\admin\\creators\\[handle]\\page.tsx:38:32\n  36 |   if (!space) notFound();\n  37 |\n> 38 |   const windowStart = new Date(Date.now() - WINDOW_DAYS * DAY_MS);\n     |                                ^^^^^^^^^^ Cannot call impure function\n  39 |\n  40 |   const [owner, tiers, account, contentCount, viewEvents, followRows30d, memberRows30d, earningsList, versions, recentEvents] = await Promise.all([\n  41 |     prisma.user.findUnique({ where: { id: space.ownerId }, select: { name: true, email: true, image: true } }),",{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"desc":"398","fix":"399"},{"kind":"396","justification":"397"},{"desc":"400","fix":"401"},{"kind":"396","justification":"397"},{"desc":"402","fix":"403"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"kind":"396","justification":"397"},{"messageId":"404","fix":"405","desc":"406"},{"messag