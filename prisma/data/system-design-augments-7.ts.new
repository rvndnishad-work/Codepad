import type { SystemDesignAugment } from "./system-design-augments.types";
const augments: SystemDesignAugment[] = [
  {
    title: "How would you design a Web Crawler?",
    answer:
      "## Design a Web Crawler\n\nA crawler must fetch **billions of pages** politely, without overloading origins, while staying fresh and deduplicating.\n\n<svg class='iq-diagram' viewBox='0 0 480 220' role='img' aria-label='Web crawler pipeline'><rect class='d-box' x='12' y='90' width='72' height='40' rx='6'/><text class='d-sub' x='48' y='115' text-anchor='middle'>Seeds</text><rect class='d-box-accent' x='130' y='88' width='110' height='44' rx='8'/><text class='d-text' x='185' y='106' text-anchor='middle'>URL Frontier</text><text class='d-sub' x='185' y='122' text-anchor='middle'>priority queue</text><rect class='d-box' x='290' y='40' width='80' height='40' rx='6'/><text class='d-sub' x='330' y='64' text-anchor='middle'>Fetcher</text><rect class='d-box' x='290' y='140' width='80' height='40' rx='6'/><text class='d-sub' x='330' y='164' text-anchor='middle'>Parser</text><rect class='d-box' x='410' y='90' width='60' height='40' rx='6'/><text class='d-sub' x='440' y='115' text-anchor='middle'>Store</text></svg>\n\n| Concern | Choice | Why |\n|---|---|---|\n| Politeness | per-host queue + `robots.txt` + crawl-delay | avoid 429/ban |\n| Freshness | priority by PageRank / change rate | recrawl hot pages |\n| Scale | sharded frontier by host hash | `n` fetchers parallel |\n| Dedup | Bloom filter + seen set in Redis | `O(1)` mem |\n\n**Interview tip:** mention `ETag/Last-Modified` conditional fetch and `SimHash` near-dedup.",
    examples: [
      {
        label: "URL frontier + Bloom dedup",
        variants: [
          { tech: "python", runnable: true, code: "from collections import deque\nimport hashlib\nseen=set()\nfrontier=deque(['https://example.com'])\nbloom={}\ndef seen_before(url):\n    h=hashlib.md5(url.encode()).hexdigest()[:8]\n    if h in bloom: return True\n    bloom[h]=1; return False\nwhile frontier:\n    url=frontier.popleft()\n    if seen_before(url): continue\n    print('fetch',url)\n    # fetcher -> parser -> push new urls\n    frontier.extend(['https://example.com/a','https://example.com/b'])\n    if len(bloom)>5: break" },
          { tech: "javascript", runnable: true, code: "const seen=new Set();\nconst frontier=['https://example.com'];\nfunction seenBefore(url){\n  const h=url.split('').reduce((a,c)=>a+c.charCodeAt(0),0)%1000;\n  if(seen.has(h)) return true;\n  seen.add(h); return false;\n}\nwhile(frontier.length){\n  const url=frontier.shift();\n  if(seenBefore(url)) continue;\n  console.log('fetch',url);\n  frontier.push('https://example.com/a');\n  if(seen.size>5) break;\n}" },
          { tech: "go", runnable: false, code: "package main\nimport \"fmt\"\nfunc main(){\n  seen:=map[string]bool{}\n  frontier:=[]string{\"https://example.com\"}\n  for len(frontier)>0{\n    url:=frontier[0]; frontier=frontier[1:]\n    if seen[url]{continue}\n    seen[url]=true\n    fmt.Println(\"fetch\",url)\n    frontier=append(frontier,\"https://example.com/a\")\n    if len(seen)>5{break}\n  }\n}" },
          { tech: "java", runnable: false, code: "import java.util.*;\npublic class Main{\n  public static void main(String[] args){\n    Set<String> seen=new HashSet<>();\n    Queue<String> q=new LinkedList<>(List.of(\"https://example.com\"));\n    while(!q.isEmpty()){\n      String url=q.poll();\n      if(!seen.add(url)) continue;\n      System.out.println(\"fetch \"+url);\n      q.add(\"https://example.com/a\");\n      if(seen.size()>5) break;\n    }\n  }\n}" },
        ],
      },
    ],
  },
  {
    title: "How would you design YouTube?",
    answer:
      "## Design YouTube\n\nYouTube is **write-heavy ingest** (transcode once) + **read-heavy global delivery** (CDN) + **social graph** (feed, comments).\n\n<svg class='iq-diagram' viewBox='0 0 480 220' role='img' aria-label='YouTube ingest and delivery'><rect class='d-box' x='12' y='90' width='70' height='40' rx='6'/><text class='d-sub' x='47' y='115' text-anchor='middle'>Upload</text><rect class='d-box-accent' x='120' y='88' width='110' height='44' rx='8'/><text class='d-text' x='175' y='106' text-anchor='middle'>Transcoder</text><text class='d-sub' x='175' y='122' text-anchor='middle'>H.264/AV1</text><rect class='d-box' x='270' y='40' width='80' height='40' rx='6'/><text class='d-sub' x='310' y='64' text-anchor='middle'>S3 + CDN</text><rect class='d-box' x='270' y='140' width='80' height='40' rx='6'/><text class='d-sub' x='310' y='164' text-anchor='middle'>Metadata</text><rect class='d-box' x='390' y='90' width='80' height='40' rx='6'/><text class='d-sub' x='430' y='115' text-anchor='middle'>Player</text></svg>\n\n| Flow | Detail |\n|---|---|\n| Ingest | presigned S3 multipart + checksum; transcode to 144p–4K buffered queue |\n| Metadata | `videos` table (MySQL) + `thumbs` in S3, search via Elasticsearch |\n| Delivery | `HLS/DASH` segmented, edge CDN `Cache-Control: public, max-age=31536000, immutable` |\n| Social | like/comment via message queue fan-out |\n\n**Interview tip:** call out `adaptive bitrate` and `shot-based encoding` (Netflix) for quality/cost.",
    examples: [
      {
        label: "Presigned upload + HLS",
        variants: [
          { tech: "python", runnable: true, code: "import boto3\ns3=boto3.client('s3')\nurl=s3.generate_presigned_url('put_object', Params={'Bucket':'videos','Key':'raw/123.mp4'}, ExpiresIn=3600)\nprint('presigned',url[:60])\n# client PUTs raw, then SQS triggers transcode to HLS 144p..4K\nprint('transcode -> HLS segments + m3u8')" },
          { tech: "javascript", runnable: true, code: "const url = 'https://cdn.example.com/videos/123/720p.m3u8';\nconsole.log('HLS manifest',url);\n// <video src=\"720p.m3u8\"> adapts via hls.js\nconst levels=['144p','480p','720p','4K'];\nconsole.log('bitrates',levels.join(','));" },
          { tech: "go", runnable: false, code: "package main\nimport \"fmt\"\nfunc main(){\n  fmt.Println(\"Generate presigned PUT for raw/123.mp4\")\n  fmt.Println(\"SQS -> transcode HLS 144p..4K\")\n  fmt.Println(\"CDN Cache-Control: immutable\")\n}" },
          { tech: "java", runnable: false, code: "public class Main{\n  public static void main(String[] args){\n    System.out.println(\"Presigned PUT raw/123.mp4\");\n    System.out.println(\"Transcode HLS 144p..4K -> S3 + CDN\");\n  }\n}" },
        ],
      },
    ],
  },
  {
    title: "How would you design Google Drive?",
    answer:
      "## Design Google Drive\n\nDrive needs **large file sync**, **conflict resolution**, and **offline**.\n\n| Piece | Pattern |\n|---|---|\n| Chunking | `4MB` blocks + `SHA-256` per chunk; only changed blocks uploaded |\n| Sync | `Differential Sync` (Neil Fraser) — diff local vs server, 3-way merge |\n| Storage | `S3` multipart + `WAL` for resumable; metadata in `MySQL` |\n| Conflict | `LWW` + user prompt if concurrent edit on same block; tombstone on delete |\n\n**Interview tip:** mention `block vs file` dedup and `presigned URL` for direct browser↔S3.",
    examples: [
      {
        label: "Chunked upload",
        variants: [
          { tech: "python", runnable: true, code: "import hashlib\ndef chunks(data, n=4):\n    return [data[i:i+n] for i in range(0,len(data),n)]\n\ndata=b'hello world file content here'\nfor c in chunks(data,4):\n    print(hashlib.sha256(c).hexdigest()[:8], c)\nprint('only changed chunks re-uploaded')" },
          { tech: "javascript", runnable: true, code: "function chunks(data,n=4){\n  const out=[];\n  for(let i=0;i<data.length;i+=n) out.push(data.slice(i,i+n));\n  return out;\n}\nconst data='hello world file';\nchunks(data,4).forEach(c=> console.log(c));\nconsole.log('dedup by hash')" },
          { tech: "go", runnable: false, code: "package main\nimport (\"crypto/sha256\"; \"fmt\")\nfunc main(){\n  data:=[]byte(\"hello world\")\n  for i:=0;i<len(data);i+=4{\n    end:=i+4; if(end>len(data)){end=len(data)}\n    h:=sha256.Sum256(data[i:end])\n    fmt.Printf(\"%x %s\\n\", h[:4], data[i:end])\n  }\n}" },
          { tech: "java", runnable: false, code: "import java.security.*;\npublic class Main{\n  public static void main(String[] a) throws Exception{\n    byte[] data=\"hello world\".getBytes();\n    MessageDigest md=MessageDigest.getInstance(\"SHA-256\");\n    for(int i=0;i<data.length;i+=4){\n      int e=Math.min(i+4,data.length);\n      md.update(data,i,e-i);\n      System.out.printf(\"%x %s%n\", md.digest()[0], new String(data,i,e-i));\n    }\n  }\n}" },
        ],
      },
    ],
  },
  {
    title: "How would you design Nearby Friends?",
    answer:
      "## Design Nearby Friends\n\nShow friends within `r` km, updating as users move — **write-heavy location** + **read-heavy geosearch**.\n\n<svg class='iq-diagram' viewBox='0 0 480 200' role='img' aria-label='Nearby friends geohash'><rect class='d-box' x='12' y='80' width='80' height='44' rx='6'/><text class='d-sub' x='52' y='106' text-anchor='middle'>Mobile</text><rect class='d-box-accent' x='140' y='80' width='110' height='44' rx='8'/><text class='d-text' x='195' y='100' text-anchor='middle'>Geohash</text><text class='d-sub' x='195' y='116' text-anchor='middle'>6-char</text><rect class='d-box' x='300' y='40' width='80' height='40' rx='6'/><text class='d-sub' x='340' y='64' text-anchor='middle'>Redis GEO</text><rect class='d-box' x='300' y='140' width='80' height='40' rx='6'/><text class='d-sub' x='340' y='164' text-anchor='middle'>Social graph</text></svg>\n\n| Trade | Choice |\n|---|---|\n| Index | `Geohash` `6` chars (~1km cell) + `Redis GEOADD/GEORADIUS` | `O(log N)` |\n| Privacy | `share = explicit opt-in` + `TTL 5m` on location | auto-expire |\n| Fan-out | pull on open (query geohash neighbors) not push | scale |\n\n**Interview tip:** mention `Quadtree` vs `Geohash` and `Haversine` distance.",
    examples: [
      {
        label: "Geohash + Redis GEO",
        variants: [
          { tech: "python", runnable: true, code: "import math\ndef geohash(lat,lon):\n    return f\"{int((lat+90)*100):04d}{int((lon+180)*100):04d}\"[:6]\nprint(geohash(37.77,-122.41))\nprint('GEOADD key lon lat member');\nprint('GEORADIUS key -122.41 37.77 1 km')" },
          { tech: "javascript", runnable: true, code: "function geohash(lat,lon){ return `${Math.floor((lat+90)*100)}${Math.floor((lon+180)*100)}`.slice(0,6); }\nconsole.log(geohash(37.77,-122.41));\nconsole.log('redis GEOADD nearby lon lat user:42');" },
          { tech: "go", runnable: false, code: "package main\nimport \"fmt\"\nfunc geohash(lat,lon float64) string{ return fmt.Sprintf(\"%04d%04d\", int((lat+90)*100), int((lon+180)*100)) }\nfunc main(){ fmt.Println(geohash(37.77,-122.41)) }" },
          { tech: "java", runnable: false, code: "public class Main{\n  static String geohash(double lat,double lon){ return String.format(\"%04d%04d\", (int)((lat+90)*100),(int)((lon+180)*100)).substring(0,6);} \n  public static void main(String[] a){ System.out.println(geohash(37.77,-122.41)); }\n}" },
        ],
      },
    ],
  },
  {
    title: "How would you design Google Maps?",
    answer:
      "## Design Google Maps\n\nMaps needs **tiles**, **places search**, **routing**, and **live traffic**.\n\n| Layer | Stack |\n|---|---|\n| Tiles | `256×256` PNG/WebP pyramids `z/x/y` CDN `immutable` + client cache |\n| Places | `Elasticsearch` + `Geohash` inverted index |\n| Routing | `Graph` `A*` + `Contraction Hierarchies` precompute; `Dijkstra` not at scale |\n| Traffic | `Kafka` probe aggregation `window 1m` + `Bayesian` ETA |\n\n**Interview tip:** mention `map matching` and `vector tiles` vs raster.",
